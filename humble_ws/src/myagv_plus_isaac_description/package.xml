<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>myagv_plus_isaac_description</name>
  <version>0.1.0</version>
  <description>Isaac Sim assets for myAGV Plus: mecanum roller URDF, imported USD stages and tooling. Not needed on the real robot.</description>
  <maintainer email="weijun.xie@elephantrobotics.com">lanni</maintainer>
  <license>BSD-3-Clause license</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>myagv_plus_description</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
